{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TLQS Module Manifest",
  "type": "object",
  "required": ["moduleKey", "name", "routePrefix", "permissions", "recordTypes"],
  "properties": {
    "moduleKey": { "type": "string" },
    "name": { "type": "string" },
    "routePrefix": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recordTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "usesFormEngine": { "type": "boolean" },
    "usesActionEngine": { "type": "boolean" },
    "usesEvidenceEngine": { "type": "boolean" },
    "dashboardWidgets": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

