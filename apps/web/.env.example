# API location. Development defaults to http://127.0.0.1:5001. Production
# defaults to the current origin, which supports a reverse-proxied API.
VITE_API_BASE_URL=

# Abort API requests that have not completed within this many milliseconds.
VITE_API_TIMEOUT_MS=30000

# Microsoft Entra ID sign-in. Leave all three blank for local development
# (the API's development authentication handler signs requests in instead).
# Client id of the SPA app registration.
VITE_ENTRA_CLIENT_ID=
# Directory (tenant) id.
VITE_ENTRA_TENANT_ID=
# Scope exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
